{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "DocsUrl": "/transpiler-service/scalar"
  },
  "ReverseProxy": {
    "Routes": {
      "transpiler-generate-route": {
        "ClusterId": "transpiler-cluster",
        "RateLimiterPolicy": "fixed",
        "Match": {
          "Path": "/transpiler-service/workflows/{**catch-all}",
          "Methods": [ "POST" ]
        },
        "Transforms": [ { "PathPattern": "/workflows/{**catch-all}" } ]
      },
      "transpiler-scalar-route": {
        "ClusterId": "transpiler-cluster",
        "Order": -10,
        "Match": {
          "Path": "/transpiler-service/scalar/{**catch-all}"
        }
      },
      "transpiler-openapi-route": {
        "ClusterId": "transpiler-cluster",
        "Order": -10,
        "Match": {
          "Path": "/transpiler-service/openapi/{**catch-all}"
        }
      },
      "transpiler-route": {
        "ClusterId": "transpiler-cluster",
        "Match": {
          "Path": "/transpiler-service/{**catch-all}"
        },
        "Transforms": [ { "PathPattern": "{**catch-all}" } ]
      }
    },
    "Clusters": {
      "transpiler-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://transpiler.api:8080"
          }
        }
      }
    }
  }
}
