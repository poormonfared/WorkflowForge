@page "/"
@rendermode InteractiveServer
@using WorkflowForge.Web.Services
@inject ITranspilerClient Transpiler
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

<PageTitle>WorkflowForge</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">WorkflowForge</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Upload an n8n workflow export, generate an owned C# project, and download it — no n8n runtime dependency at execution time.
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">1. Upload workflow</MudText>

    <MudFileUpload T="IBrowserFile" Accept=".json" OnFilesChanged="OnFileSelectedAsync" MaxFileSize="10485760" Disabled="@_isUploading">
        <CustomContent>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="@_isUploading">
                @(_isUploading ? "Uploading…" : "Choose file")
            </MudButton>
        </CustomContent>
    </MudFileUpload>

    @if (_isUploading)
    {
        <MudProgressLinear Indeterminate="true" Class="mt-3" Color="Color.Primary" />
    }

    @if (_uploadResult is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true">
            Uploaded <strong>@_uploadResult.WorkflowName</strong>
        </MudAlert>

        @if (_uploadResult.Diagnostics.Count > 0)
        {
            <MudList T="string" Dense="true" Class="mt-2">
                @foreach (var diagnostic in _uploadResult.Diagnostics)
                {
                    <MudListItem Icon="@Icons.Material.Filled.Info">@diagnostic</MudListItem>
                }
            </MudList>
        }
    }
</MudPaper>

@if (_uploadResult is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">2. Generate C# project</MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GenerateAsync" Disabled="@_isGenerating" StartIcon="@Icons.Material.Filled.Build">
            @(_isGenerating ? "Generating…" : "Generate C# project")
        </MudButton>

        @if (_isGenerating)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" Color="Color.Primary" />
        }

        @if (_generateResult is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4" Dense="true">
                Generated @_generateResult.FilePaths.Count file(s)
            </MudAlert>

            @if (_generateResult.Warnings.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">Follow-up needed:</MudText>
                <MudList T="string" Dense="true">
                    @foreach (var warning in _generateResult.Warnings)
                    {
                        <MudListItem Icon="@Icons.Material.Filled.Warning" IconColor="Color.Warning">@warning</MudListItem>
                    }
                </MudList>
            }
        }
    </MudPaper>
}

@if (_generateResult is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">3. Download project</MudText>

        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="DownloadAsync" Disabled="@_isDownloading" StartIcon="@Icons.Material.Filled.Download">
            @(_isDownloading ? "Preparing…" : "Download project (.zip)")
        </MudButton>

        @if (_isDownloading)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" Color="Color.Primary" />
        }
    </MudPaper>
}

@code {
    private UploadWorkflowResult? _uploadResult;
    private GenerateProjectResult? _generateResult;
    private bool _isUploading;
    private bool _isGenerating;
    private bool _isDownloading;

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _uploadResult = null;
        _generateResult = null;
        _isUploading = true;

        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            _uploadResult = await Transpiler.UploadAsync(stream);
            Snackbar.Add($"Uploaded '{_uploadResult.WorkflowName}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task GenerateAsync()
    {
        if (_uploadResult is null)
        {
            return;
        }

        _isGenerating = true;
        try
        {
            _generateResult = await Transpiler.GenerateAsync(_uploadResult.WorkflowId);
            Snackbar.Add($"Generated {_generateResult.FilePaths.Count} file(s).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (_uploadResult is null)
        {
            return;
        }

        _isDownloading = true;
        try
        {
            var zipBytes = await Transpiler.DownloadAsync(_uploadResult.WorkflowId);
            await JsRuntime.InvokeVoidAsync("workflowForge.downloadFile", $"{_uploadResult.WorkflowName}.zip", Convert.ToBase64String(zipBytes));
            Snackbar.Add("Download ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isDownloading = false;
        }
    }
}
